# OpenAI-compatible chat endpoint used by the Vistora editing agent.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Optional override for the project-local ComfyUI provider sidecar.
# When omitted, Vistora looks beside the active timeline project for
# <project-stem>.comfyui-provider.json.
VISTORA_COMFYUI_CONFIG=

# Optional HyperFrames provider sidecar. Keep its runtime_root and npm cache on
# a non-system drive; the example pins HyperFrames 0.7.94.
VISTORA_HYPERFRAMES_CONFIG=

# Optional licensed stock-video provider. Keep API keys in the environment,
# never in a project file. Pexels is preferred; Pixabay is the fallback.
VISTORA_STOCK_VIDEO_CONFIG=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional isolated word-alignment runtime used for narration-bound subtitles.
# Both values are required together; production fails closed when omitted.
VISTORA_ALIGNMENT_PYTHON=
VISTORA_ALIGNMENT_MODEL=
